{
  "name": "goalmate",
  "version": "3.0.0",
  "description": "GoalMate — a goal planner with AI roadmaps (Gemini), a Notion-style journal attached to every task, and insights on how you actually work. Node.js + Express + PostgreSQL backend, React frontend.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/src/index.js",
    "build": "vite build",
    "start": "node server/src/index.js --prod",
    "db:reset": "node server/src/scripts/reset-db.js",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "author": "Yuvraj Malethia",
  "license": "MIT",
  "dependencies": {
    "@blocknote/core": "^0.54.2",
    "@blocknote/mantine": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tanstack/react-query": "^5.103.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  }
}
