# Copy this file to `.env` (same folder as package.json) and fill in the values.
# `.env` is git-ignored; never commit your real key.

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Local setup (see README): user goalmate, password goalmate, database goalmate.
# Hosted databases (Neon, Render, Supabase) give you a URL ending in ?sslmode=require.
DATABASE_URL=postgres://goalmate:goalmate@localhost:5432/goalmate

# Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Puts one model first in both fallback lists. Leave empty to use the
# built-in lists in server/src/config.js (Flash models, then Flash-Lite).
GEMINI_MODEL=

# Optional locally, required in production. Signs login cookies. If empty, a
# random secret is generated once and kept in .jwt-secret (git-ignored).
JWT_SECRET=

PORT=5000
